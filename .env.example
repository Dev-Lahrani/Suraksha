# ---- Suraksha configuration (copy to .env) ----

# LLM agent (Nugen API = sponsor credits; any OpenAI-compatible endpoint works)
NUGEN_API_KEY=
NUGEN_BASE_URL=https://api.nugen.xyz/v1
NUGEN_MODEL=nugen-flash-llm
# Optional OpenAI-compatible fallback
OPENAI_API_KEY=

# WhatsApp Cloud API (sandbox is enough for the demo)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-for-your-webhook
WHATSAPP_APP_SECRET=
# Protect administrative API calls with the X-API-Key header.
ADMIN_API_KEY=
# Offline hackathon demo: set BOTH DEMO_MODE=true and a separate demo DB.
DEMO_MODE=false
DATABASE_URL=sqlite:///data/suraksha.db
INGEST_ON_STARTUP=true

# Free TTS (edge-tts voices); leave empty to disable voice replies
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_MR=mr-IN-AarohiNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_VOICE_KN=kn-IN-SapnaNeural
TTS_VOICE_BN=bn-IN-TanishaaNeural
TTS_VOICE_GU=gu-IN-DhwaniNeural
TTS_VOICE_PA=
TTS_VOICE_ML=ml-IN-SobhanaNeural
TTS_VOICE_UR=ur-IN-GulNeural

# Server
HOST=0.0.0.0
PORT=8000
# Cron ingestion interval in minutes
INGEST_INTERVAL_MINUTES=60
